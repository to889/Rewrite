#!name = FT中文网
!icon = https://raw.githubusercontent.com/to889/Loon/refs/heads/Loon/FT.png

[Script]
# 解锁会员功能
http-response ^https?:\/\/.*\.cloudfront\.net\/index\.php\/jsapi\/(paywall|get_story_more_info) requires-body=1,script-code=var ddm=JSON.parse($response.body);if(/paywall/.test($request.url)){Object.assign(ddm,{"paywall":0,"premium":1,"expire":"4092599349","standard":1,"v":2099,"campaign_code":"","latest_duration":"yearly","addon":1});}if(/get_story_more_info/.test($request.url)){ddm.paywall=0;ddm.accessright="1";}$done({body:JSON.stringify(ddm)});,tag=FT中文网会员解锁

# 拦截 FT 中文网广告 API
http-response ^https:\/\/www\.ftchinese\.com\/m\/ad\/(index|start).json$ reject-200,tag=FT广告拦截1
http-response ^https:\/\/www\.ftchinese\.com\/ad\/.*$ reject-200,tag=FT广告拦截2
http-response ^https:\/\/ads.*\.ftchinese\.com\/.*$ reject-200,tag=FT广告拦截3
http-response ^https:\/\/ftmailbox\.cn\/ad_impression\/.*$ reject-200,tag=FT广告拦截4

# 拦截 Google 广告脚本
http-response ^https:\/\/securepubads\.g\.doubleclick\.net\/pagead\/managed\/js\/gpt\/.*$ reject-200,tag=Google广告脚本1
http-response ^https:\/\/securepubads\.g\.doubleclick\.net\/pagead\/ppub_config.*$ reject-200,tag=Google广告脚本2

[MITM]
hostname = *.cloudfront.net, *.ftchinese.com, ads.ftchinese.com, ftmailbox.cn, securepubads.g.doubleclick.net

*************************************/

var ddm = JSON.parse($response.body);

if(/paywall/.test($request.url)){
  Object.assign(ddm, {
    "paywall": 0,
    "premium": 1,
    "expire": "4092599349",
    "standard": 1,
    "v": 2099,
    "campaign_code": "",
    "latest_duration": "yearly",
    "addon": 1
  });
}

if(/get_story_more_info/.test($request.url)){
  ddm.paywall = 0;
  ddm.accessright = "1";
}

$done({ body: JSON.stringify(ddm) });

